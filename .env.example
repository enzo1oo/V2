# Copy to .env (git-ignored) and fill in. Never commit .env or paste its values anywhere.
# Used by local runs and scripts/live_check.py. In production these come from Secret Manager.

# IDs (not secret)
SHEET_ID=                  # from the DEV sheet's URL: docs.google.com/spreadsheets/d/<this>/edit
SHARED_DRIVE_FOLDER_ID=    # from the Drive folder's URL: drive.google.com/drive/folders/<this>
GCP_PROJECT=               # only needed for Vertex mode

# Bot mailbox (secret)
OAUTH_CLIENT_FILE=         # path to the downloaded OAuth client JSON, e.g. ~/secrets/oauth_client.json
GMAIL_REFRESH_TOKEN=       # printed once by scripts/mint_gmail_token.py

# Gemini (secret)
GEMINI_API_KEY=
