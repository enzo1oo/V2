# Every setting the service reads (app/settings.py). Copy to .env (git-ignored) for local runs
# (uvicorn app.main:app --env-file .env) and scripts/live_check.py. Never commit .env.
# One line per setting, value right after the = (no quotes needed). Point it at the DEV sheet.
# In production: the non-secret values live in deploy/env.prod.yaml (secret grc-env-prod) and the
# secrets in Secret Manager (deploy/secrets.txt); Cloud Run sets them as these same variables.

# --- Google Cloud and the sheet (not secret) ---
GCP_PROJECT=               # project ID
GCP_REGION=                # asia-southeast2 (Jakarta)
SHEET_ID=                  # docs.google.com/spreadsheets/d/<this>/edit (the full URL also works)
SHARED_DRIVE_FOLDER_ID=    # only with Config "File storage" = Drive
SERVICE_URL=               # https://v2-git-<project number>.asia-southeast2.run.app
SCHEDULER_SA_EMAIL=        # grc-tracker-scheduler@<project ID>.iam.gserviceaccount.com
RUNTIME_SA_EMAIL=          # grc-tracker-run@<project ID>.iam.gserviceaccount.com
CHAT_PROJECT_NUMBER=       # the project number

# --- WhatsApp bot (not secret; leave empty to keep the bot off) ---
WA_PHONE_NUMBER_ID=        # Meta app > WhatsApp > API setup > Phone number ID
WA_WABA_ID=                # WhatsApp Business Account ID
WA_GRAPH_VERSION=          # the Meta app's Graph API version, e.g. v23.0
WA_VERIFY_TOKEN=           # long random string, also typed into Meta's webhook settings
WA_TASKS_QUEUE=            # Cloud Tasks queue, default wa-process

# --- Secrets (production: Secret Manager, see deploy/secrets.txt) ---
GMAIL_REFRESH_TOKEN=       # printed once by scripts/mint_gmail_token.py (starts with 1//)
OAUTH_CLIENT_SECRET=       # the OAuth client JSON on one line; or use OAUTH_CLIENT_FILE below
OAUTH_CLIENT_FILE=         # laptop only: FULL path to the downloaded OAuth client JSON
GEMINI_API_KEY=            # Google AI Studio key
WA_ACCESS_TOKEN=           # Meta system-user permanent token
WA_APP_SECRET=             # Meta app secret
