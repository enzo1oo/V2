# Copy to .env (git-ignored) and fill in. Never commit .env or paste its values anywhere.
# One line per setting, value right after the = (no line breaks, quotes optional).
# SHEET_ID and SHARED_DRIVE_FOLDER_ID also accept the full URL.
# Used by local runs and scripts/live_check.py. In production these come from Secret Manager.

# IDs (not secret)
SHEET_ID=                  # from the DEV sheet's URL: docs.google.com/spreadsheets/d/<this>/edit
SHARED_DRIVE_FOLDER_ID=    # only if Config "File storage" = Drive; from drive.google.com/drive/folders/<this>
GCP_PROJECT=               # only needed for Vertex mode

# Bot mailbox (secret)
OAUTH_CLIENT_FILE=         # FULL path to the downloaded OAuth client JSON, e.g. /Users/you/secrets/client.json
GMAIL_REFRESH_TOKEN=       # printed once by scripts/mint_gmail_token.py

# Gemini (secret)
GEMINI_API_KEY=

# WhatsApp bot (optional, DESIGN section 17). Leave empty to keep the bot off.
WA_PHONE_NUMBER_ID=        # Meta app → WhatsApp → API setup → Phone number ID
WA_WABA_ID=                # WhatsApp Business Account ID
WA_GRAPH_VERSION=          # the Graph API version of the Meta app, e.g. v23.0
WA_VERIFY_TOKEN=           # any long random string; the same one goes into Meta's webhook settings
WA_TASKS_QUEUE=            # Cloud Tasks queue name (default wa-process)
RUNTIME_SA_EMAIL=          # grc-tracker-run@<project>.iam.gserviceaccount.com (Cloud Tasks runs as it)
WA_ACCESS_TOKEN=           # secret: system-user permanent token
WA_APP_SECRET=             # secret: Meta app secret (checks webhook signatures)
