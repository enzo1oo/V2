# Non-secret production settings. Copy to deploy/env.prod.yaml (git-ignored), fill it in, then
# store it with: deploy/setup_secrets.sh env   (it becomes the Secret Manager secret grc-env-prod,
# which deploy.sh and cloudbuild.yaml read). Secrets never go here: see deploy/secrets.txt.
# Every value is a string: keep the quotes. Leave the WA_* values empty to keep WhatsApp off.
GCP_PROJECT: ""            # the project ID, e.g. electric-cortex-513009-d7
GCP_REGION: "asia-southeast2"
SHEET_ID: ""               # from the sheet URL: docs.google.com/spreadsheets/d/<this>/edit
SHARED_DRIVE_FOLDER_ID: "" # only with Config "File storage" = Drive
SERVICE_URL: ""            # https://v2-git-<project number>.asia-southeast2.run.app
SCHEDULER_SA_EMAIL: ""     # grc-tracker-scheduler@<project ID>.iam.gserviceaccount.com
RUNTIME_SA_EMAIL: ""       # grc-tracker-run@<project ID>.iam.gserviceaccount.com
CHAT_PROJECT_NUMBER: ""    # the project number (the number in SERVICE_URL)
GMAIL_PUSH_TOPIC: ""       # projects/<project ID>/topics/grc-gmail-push (blank = no instant email)
WA_PHONE_NUMBER_ID: ""     # Meta app > WhatsApp > API setup
WA_WABA_ID: ""             # WhatsApp Business Account ID
WA_GRAPH_VERSION: ""       # the Meta app's Graph API version, e.g. v23.0
WA_VERIFY_TOKEN: ""        # a long random string; type the same one into Meta's webhook settings
WA_TASKS_QUEUE: "wa-process"
TZ: "Asia/Hong_Kong"
